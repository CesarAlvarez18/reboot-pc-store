# Copia este archivo a backend/.env para desarrollo local.
# En Railway estas variables se configuran en el panel del servicio; el .env no se
# despliega ni se versiona.

# Generar una distinta para producción:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambiar-esto-por-una-clave-generada

DEBUG=True

# Railway la inyecta automáticamente al vincular el plugin de PostgreSQL.
DATABASE_URL=postgres://reboot:reboot@localhost:5432/reboot

# Fotos de los equipos en Cloudflare R2. Sin R2_BUCKET, las fotos se guardan en
# disco local: sirve para desarrollo, pero en Railway el disco se borra en cada
# despliegue y las fotos se perderian. En produccion estas cuatro son obligatorias.
R2_BUCKET=
R2_ENDPOINT_URL=https://<id-de-cuenta>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Dominio publico del bucket (el r2.dev del bucket, o uno propio conectado a el).
R2_PUBLIC_DOMAIN=

ALLOWED_HOSTS=localhost,127.0.0.1,.up.railway.app,rebootpcstore.com,www.rebootpcstore.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,https://*.up.railway.app,https://rebootpcstore.com,https://www.rebootpcstore.com

# Si el puerto 5432 ya lo ocupa un PostgreSQL instalado en la máquina, corre el
# contenedor en otro puerto y ajústalo acá:
#   docker run -d --name reboot-postgres -e POSTGRES_USER=reboot -e POSTGRES_PASSWORD=reboot -e POSTGRES_DB=reboot -p 5433:5432 postgres:16-alpine
